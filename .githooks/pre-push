#!/bin/sh
if [ "${DALGO_ALLOW_PROTECTED_PUSH:-}" = "1" ]; then
  exit 0
fi

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct pushes to main are blocked. Push develop and promote with a pull request." >&2
    exit 1
  fi
done
