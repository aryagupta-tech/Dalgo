# Copy to ignored .dev.vars (local) or .dev.vars.staging (local staging).
# Deploy secrets individually to the matching Wrangler environment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
WEBSOCKET_SIGNING_SECRET=
JUDGE_PROVIDER=codebox
CODEBOX_AUTH_TOKEN=
CODEBOX_LOCAL_URL=http://127.0.0.1:3000
MAX_ACTIVE_MATCHES=1
TESTER_USER_IDS=
ADMISSION_MODE=disabled
LIVE_MATCHES_ENABLED=false
JUDGE_VERIFIED_AT=
JUDGE_CONCURRENCY=1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Per-player attempts; interrupted HTTP requests reuse the same execution.
MATCH_RUN_LIMIT=3
MATCH_SUBMISSION_LIMIT=5
