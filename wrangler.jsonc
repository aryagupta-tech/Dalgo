{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalgo-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "Coordinator" },
      { "name": "MATCHES", "class_name": "MatchRoom" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Coordinator", "MatchRoom"] },
  ],
  "vars": {
    "LIVE_MATCHES_ENABLED": "false",
    "JUDGE_VERIFIED_AT": "",
    "JUDGE_DAILY_QUOTA": "0",
    "JUDGE_CREDIT_COST": "0",
    "JUDGE_CONCURRENCY": "0",
    "JUDGE_RESET_HOUR_UTC": "",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173",
  },
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": { "enabled": true },
}
