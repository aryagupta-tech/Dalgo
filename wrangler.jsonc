{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalgo-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "Coordinator",
      },
      {
        "name": "MATCHES",
        "class_name": "MatchRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Coordinator", "MatchRoom"],
    },
  ],
  "vars": {
    "ADMISSION_MODE": "disabled",
    "LIVE_MATCHES_ENABLED": "false",
    "JUDGE_VERIFIED_AT": "",
    "JUDGE_DAILY_QUOTA": "0",
    "JUDGE_CREDIT_COST": "0",
    "JUDGE_PROVIDER": "codebox",
    "MAX_ACTIVE_MATCHES": "1",
    "JUDGE_CONCURRENCY": "1",
    "JUDGE_RESET_HOUR_UTC": "",
    "GOOGLE_CLIENT_ID": "150391103154-bild0sgve9gv1smf8vq243jd2vtatgbk.apps.googleusercontent.com",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173",
  },
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
  },
  "env": {
    "staging": {
      "name": "dalgo-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "staging.dalgo.site",
          "custom_domain": true,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "COORDINATOR",
            "class_name": "Coordinator",
          },
          {
            "name": "MATCHES",
            "class_name": "MatchRoom",
          },
        ],
      },
      "vars": {
        "ADMISSION_MODE": "staging",
        "LIVE_MATCHES_ENABLED": "true",
        "JUDGE_VERIFIED_AT": "2026-09-20T07:49:07.429Z",
        "JUDGE_DAILY_QUOTA": "0",
        "JUDGE_CREDIT_COST": "0",
        "JUDGE_PROVIDER": "codebox",
        "MAX_ACTIVE_MATCHES": "1",
        "JUDGE_CONCURRENCY": "1",
        "JUDGE_RESET_HOUR_UTC": "",
        "GOOGLE_CLIENT_ID": "150391103154-bild0sgve9gv1smf8vq243jd2vtatgbk.apps.googleusercontent.com",
        "ALLOWED_ORIGINS": "",
      },
      "triggers": {
        "crons": ["0 3 * * *"],
      },
      "vpc_services": [
        {
          "binding": "CODEBOX",
          "service_id": "01a0bdc2-e64f-7b63-8dae-b0c78031a859",
        },
      ],
    },
    "production": {
      "name": "dalgo",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "dalgo.site",
          "custom_domain": true,
        },
        {
          "pattern": "www.dalgo.site",
          "custom_domain": true,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "COORDINATOR",
            "class_name": "Coordinator",
          },
          {
            "name": "MATCHES",
            "class_name": "MatchRoom",
          },
        ],
      },
      "vars": {
        "ADMISSION_MODE": "public",
        "LIVE_MATCHES_ENABLED": "true",
        "JUDGE_VERIFIED_AT": "2026-09-20T07:49:07.429Z",
        "JUDGE_DAILY_QUOTA": "0",
        "JUDGE_CREDIT_COST": "0",
        "JUDGE_PROVIDER": "codebox",
        "MAX_ACTIVE_MATCHES": "1",
        "JUDGE_CONCURRENCY": "1",
        "JUDGE_RESET_HOUR_UTC": "",
        "GOOGLE_CLIENT_ID": "150391103154-bild0sgve9gv1smf8vq243jd2vtatgbk.apps.googleusercontent.com",
        "ALLOWED_ORIGINS": "",
      },
      "triggers": {
        "crons": ["0 3 * * *"],
      },
      "vpc_services": [
        {
          "binding": "CODEBOX",
          "service_id": "01a0bdc2-e64f-7b63-8dae-b0c78031a859",
        },
      ],
    },
  },
}
