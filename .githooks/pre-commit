#!/bin/sh
branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
case "$branch" in
  main|develop)
    if [ "${DALGO_ALLOW_PROTECTED_COMMIT:-}" != "1" ]; then
      echo "Direct commits to $branch are blocked. Create a feature branch and open a pull request." >&2
      exit 1
    fi
    ;;
esac
