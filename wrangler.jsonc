{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dalgo-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "Coordinator",
      },
      {
        "name": "MATCHES",
        "class_name": "MatchRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Coordinator", "MatchRoom"],
    },
  ],
  "vars": {
    "ADMISSION_MODE": "disabled",
    "LIVE_MATCHES_ENABLED": "false",
    "JUDGE_VERIFIED_AT": "",
    "JUDGE_DAILY_QUOTA": "0",
    "JUDGE_CREDIT_COST": "0",
    "JUDGE_PROVIDER": "codebox",
    "MAX_ACTIVE_MATCHES": "1",
    "JUDGE_CONCURRENCY": "1",
    "JUDGE_RESET_HOUR_UTC": "",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173",
  },
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
  },
  "env": {
    "staging": {
      "name": "dalgo-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "COORDINATOR",
            "class_name": "Coordinator",
          },
          {
            "name": "MATCHES",
            "class_name": "MatchRoom",
          },
        ],
      },
      "vars": {
        "ADMISSION_MODE": "staging",
        "LIVE_MATCHES_ENABLED": "false",
        "JUDGE_VERIFIED_AT": "",
        "JUDGE_DAILY_QUOTA": "0",
        "JUDGE_CREDIT_COST": "0",
        "JUDGE_PROVIDER": "codebox",
        "MAX_ACTIVE_MATCHES": "1",
        "JUDGE_CONCURRENCY": "1",
        "JUDGE_RESET_HOUR_UTC": "",
        "ALLOWED_ORIGINS": "",
      },
      "triggers": {
        "crons": ["0 3 * * *"],
      },
    },
    "production": {
      "name": "dalgo",
      "durable_objects": {
        "bindings": [
          {
            "name": "COORDINATOR",
            "class_name": "Coordinator",
          },
          {
            "name": "MATCHES",
            "class_name": "MatchRoom",
          },
        ],
      },
      "vars": {
        "ADMISSION_MODE": "disabled",
        "LIVE_MATCHES_ENABLED": "false",
        "JUDGE_VERIFIED_AT": "",
        "JUDGE_DAILY_QUOTA": "0",
        "JUDGE_CREDIT_COST": "0",
        "JUDGE_PROVIDER": "codebox",
        "MAX_ACTIVE_MATCHES": "1",
        "JUDGE_CONCURRENCY": "1",
        "JUDGE_RESET_HOUR_UTC": "",
        "ALLOWED_ORIGINS": "",
      },
      "triggers": {
        "crons": ["0 3 * * *"],
      },
    },
  },
}
