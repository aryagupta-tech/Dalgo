# Copy to ignored .dev.vars (local) or .dev.vars.staging (local staging).
# Deploy secrets individually to the matching Wrangler environment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
WEBSOCKET_SIGNING_SECRET=
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
TESTER_USER_IDS=
ADMISSION_MODE=disabled
LIVE_MATCHES_ENABLED=false
JUDGE_VERIFIED_AT=
JUDGE_DAILY_QUOTA=0
JUDGE_CREDIT_COST=0
JUDGE_CONCURRENCY=0
JUDGE_RESET_HOUR_UTC=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Agreed per-player attempts; two extra retry executions are reserved.
MATCH_RUN_LIMIT=3
MATCH_SUBMISSION_LIMIT=5
