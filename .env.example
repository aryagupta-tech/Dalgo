# Public frontend configuration (optional when frontend and API share a Worker)
VITE_API_BASE=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Worker configuration: copy these into .dev.vars locally; use wrangler secrets in production.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
# Never enable before docs/LAUNCH.md checks pass with your actual accounts.
LIVE_MATCHES_ENABLED=false
JUDGE_VERIFIED_AT=
JUDGE_DAILY_QUOTA=0
JUDGE_CREDIT_COST=0
JUDGE_CONCURRENCY=0
JUDGE_RESET_HOUR_UTC=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
