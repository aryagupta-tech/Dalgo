# Optional frontend values. Same-origin Workers deployment uses /api/config.
VITE_API_BASE=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local setup scripts; keep these in ignored .env. Never use a VITE_ prefix.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
# Judge verification is opt-in; these values must come from your actual account.
JUDGE_DAILY_QUOTA=0
JUDGE_CREDIT_COST=0
JUDGE_CONCURRENCY=0
JUDGE_RESET_HOUR_UTC=
# See .dev.vars.example for the local Worker, and docs/LAUNCH.md for staging.

# Agreed per-player attempts; two extra retry executions are reserved.
MATCH_RUN_LIMIT=3
MATCH_SUBMISSION_LIMIT=5
