# Optional frontend values. Same-origin Workers deployment uses /api/config.
VITE_API_BASE=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local setup scripts; keep these in ignored .env. Never use a VITE_ prefix.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JUDGE_PROVIDER=codebox
CODEBOX_AUTH_TOKEN=
CODEBOX_LOCAL_URL=http://127.0.0.1:3000
MAX_ACTIVE_MATCHES=1
# Codebox verification runs against localhost or an SSH port forward.
JUDGE_CONCURRENCY=1
# See .dev.vars.example for the local Worker, and docs/LAUNCH.md for staging.

# Per-player attempts; interrupted HTTP requests reuse the same execution.
MATCH_RUN_LIMIT=3
MATCH_SUBMISSION_LIMIT=5
